# Template file for 'lyargoos-kde-theme'
pkgname=lyargoos-kde-theme
version=0.1
revision=1
build_style=gnu-makefile
depends="breeze-icons"
short_desc="LyargoOS KDE Plasma theme — color scheme, SDDM theme, desktop theme"
maintainer="Meniny <meniny@qq.com>"
license="CC-BY-4.0"
homepage="https://github.com/Meniny/LyargoOS-Artworks"
# Same source as lyargoos-artwork — the KDE theme files live under kde/
distfiles="https://github.com/Meniny/LyargoOS-Artworks/archive/refs/tags/v${version}.tar.gz"
checksum=753e143da13d0f93b23b6e011d4c853a4f42975a28ce7e712f02c7f96d279c51
wrksrc="LyargoOS-Artworks-${version}"
nostrip=yes

do_build() {
	:
}

do_install() {
	# Color schemes
	if [ -d kde/color-schemes ]; then
		vmkdir usr/share/color-schemes
		for f in kde/color-schemes/*.colors; do
			[ -f "$f" ] || continue
			install -m644 "$f" ${DESTDIR}/usr/share/color-schemes/
		done
	fi

	# SDDM login theme
	if [ -d kde/sddm-theme ]; then
		vmkdir usr/share/sddm/themes/lyargoos
		cp -r kde/sddm-theme/* ${DESTDIR}/usr/share/sddm/themes/lyargoos/
	fi

	# Plasma desktop theme
	if [ -d kde/desktop-theme ]; then
		vmkdir usr/share/plasma/desktoptheme/lyargoos
		cp -r kde/desktop-theme/* ${DESTDIR}/usr/share/plasma/desktoptheme/lyargoos/
	fi
}

# Template file for 'flclash'
pkgname=flclash
version=0.8.96
revision=1
archs="x86_64"
depends="libkeybinder3 libayatana-appindicator"
short_desc="Multi-platform proxy client based on ClashMeta"
maintainer="Meniny <meniny@qq.com>"
license="GPL-3.0-only"
homepage="https://github.com/chen08209/FlClash"
distfiles="https://github.com/chen08209/FlClash/releases/download/v${version}/FlClash-${version}-linux-amd64.AppImage"
checksum=7a874aac6ce7608d268d25a94690b995c6c06ddd1c66851678c821c8052d3cee
nostrip=yes
skipwithuptodate=yes
create_wrksrc=yes

do_extract() {
	# Create wrksrc to satisfy xbps-src
	mkdir -p ${XBPS_BUILDDIR}/${pkgname}-${version}
}

do_install() {
	# Create wrksrc to satisfy xbps-src check (we don't actually use it)
	mkdir -p ${XBPS_BUILDDIR}/${pkgname}-${version}
	
	vmkdir opt/flclash
	vmkdir usr/bin
	
	# Extract to temp location
	EXTRACT_DIR=$(mktemp -d)
	cd "$EXTRACT_DIR"
	APPIMAGE="${XBPS_SRCDISTDIR}/${pkgname}-${version}/FlClash-${version}-linux-amd64.AppImage"
	chmod +x "$APPIMAGE"
	"$APPIMAGE" --appimage-extract
	cd squashfs-root

	# Copy the extracted AppImage contents
	for item in AppRun FlClash FlClashCore data lib usr; do
		if [ -e "$item" ]; then
			cp -a "$item" ${DESTDIR}/opt/flclash/
		fi
	done

	# Install wrapper script
	cat > ${DESTDIR}/usr/bin/flclash << 'WRAPPER'
#!/bin/sh
cd /opt/flclash
LD_LIBRARY_PATH=lib exec ./FlClash "$@"
WRAPPER
	chmod 755 ${DESTDIR}/usr/bin/flclash

	# Install desktop file
	vinstall ${FILESDIR}/FlClash.desktop 644 usr/share/applications

	# Install icons from extracted contents
	for size in 128 256; do
		if [ -f "usr/share/icons/hicolor/${size}x${size}/apps/FlClash.png" ]; then
			vinstall "usr/share/icons/hicolor/${size}x${size}/apps/FlClash.png" 644 \
				usr/share/icons/hicolor/${size}x${size}/apps flclash.png
		fi
	done

	# Install custom SVG icon
	vinstall ${FILESDIR}/FlClash.svg 644 usr/share/icons/hicolor/scalable/apps flclash.svg
	
	# Cleanup
	cd /
	rm -rf "$EXTRACT_DIR"
}

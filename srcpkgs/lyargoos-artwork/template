# Template file for 'lyargoos-artwork'
pkgname=lyargoos-artwork
version=0.1.0
revision=1
build_style=gnu-makefile
short_desc="LyargoOS artwork — wallpapers, logos, splash screen"
maintainer="Meniny <meniny@qq.com>"
license="CC-BY-4.0"
homepage="https://github.com/Meniny/LyargoOS-Artworks"
distfiles="https://github.com/Meniny/LyargoOS-Artworks/archive/refs/tags/v${version}.tar.gz"
checksum=b7479d5f4ac705ebfce0c0a9690a67fe1b393102d54c7ee5b141f1f91dab0cfb
wrksrc="LyargoOS-Artworks-${version}"
nostrip=yes

do_build() {
	:
}

do_install() {
	# Plasma wallpapers (installed to /usr/share/wallpapers/)
	if [ -d wallpapers-plasma ]; then
		vmkdir usr/share/wallpapers
		cp -a wallpapers-plasma/* ${DESTDIR}/usr/share/wallpapers/
	fi

	# Logos
	if [ -d logos ]; then
		vmkdir usr/share/pixmaps
		for f in logos/*; do
			[ -f "$f" ] || continue
			install -m644 "$f" ${DESTDIR}/usr/share/pixmaps/
		done
		
		# Install SVG icon to hicolor theme for KDE system info
		if [ -f logos/lyargoos-logo.svg ]; then
			vmkdir usr/share/icons/hicolor/scalable/apps
			install -m644 logos/lyargoos-logo.svg ${DESTDIR}/usr/share/icons/hicolor/scalable/apps/
		fi
	fi

	# Splash screen
	if [ -d splash ]; then
		vmkdir usr/share/lyargoos/splash
		for f in splash/*; do
			[ -f "$f" ] || continue
			install -m644 "$f" ${DESTDIR}/usr/share/lyargoos/splash/
		done
	fi
}

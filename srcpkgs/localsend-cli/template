do_install() {
	vmkdir opt/localsend-cli
	vcopy "*" opt/localsend-cli

	vmkdir usr/bin
	ln -sf /opt/localsend-cli/localsend-cli ${DESTDIR}/usr/bin/localsend-cli
}

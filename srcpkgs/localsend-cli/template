case "$XBPS_TARGET_MACHINE" in
    x86_64)
        distfiles="https://github.com/localsend/localsend/releases/download/v${version}/LocalSend-CLI-${version}-linux-x86-64.tar.gz"
        checksum=f5a986e0b4701b9aafeb9747225a2f3e314e97aba61b3dd7c9d076226f512b08

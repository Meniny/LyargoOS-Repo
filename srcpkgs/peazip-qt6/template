# Template file for 'peazip-qt6'
pkgname=peazip-qt6
version=11.2.0
revision=1
archs="x86_64"
short_desc="Free file archiver and compressor with broad format support (Qt6)"
maintainer="Meniny <meniny@qq.com>"
license="LGPL-3.0-only"
homepage="https://peazip.github.io/"
distfiles="https://github.com/peazip/PeaZip/releases/download/${version}/peazip_portable-${version}.LINUX.Qt6.${XBPS_TARGET_MACHINE}.tar.gz"
checksum=e81f46854e0cf192f9eea3c51b41937ae308981f3849b8242503a77dd04bbdac
nostrip=yes

do_install() {
	vmkdir opt/peazip
	vcopy "*" opt/peazip

	# Remove bundled 32-bit arc backend (requires libgmp.so.3/libncurses.so.5, unresolvable on 64-bit systems)
	rm -f ${DESTDIR}/opt/peazip/res/bin/arc/arc

	# Install wrapper to make it available in PATH
	vmkdir usr/bin
	cat > ${DESTDIR}/usr/bin/peazip << 'WRAPPER'
#!/bin/sh
cd /opt/peazip
LD_LIBRARY_PATH=. exec ./peazip "$@"
WRAPPER
	chmod 755 ${DESTDIR}/usr/bin/peazip

	# Install desktop file from bundled resources
	if [ -f "${DESTDIR}/opt/peazip/res/share/batch/freedesktop_integration/peazip.desktop" ]; then
		vinstall "${DESTDIR}/opt/peazip/res/share/batch/freedesktop_integration/peazip.desktop" 644 \
			usr/share/applications
	elif [ -f "${FILESDIR}/peazip.desktop" ]; then
		vinstall ${FILESDIR}/peazip.desktop 644 usr/share/applications
	fi

	# Install icons from bundled resources
	if [ -d "${DESTDIR}/opt/peazip/res/share/icons" ]; then
		for f in ${DESTDIR}/opt/peazip/res/share/icons/*.png; do
			[ -f "$f" ] || continue
			_name=$(basename "$f")
			case "$_name" in
				16x16*)   vinstall "$f" 644 usr/share/icons/hicolor/16x16/apps peazip.png ;;
				32x32*)   vinstall "$f" 644 usr/share/icons/hicolor/32x32/apps peazip.png ;;
				48x48*)   vinstall "$f" 644 usr/share/icons/hicolor/48x48/apps peazip.png ;;
				64x64*)   vinstall "$f" 644 usr/share/icons/hicolor/64x64/apps peazip.png ;;
				128x128*) vinstall "$f" 644 usr/share/icons/hicolor/128x128/apps peazip.png ;;
				256x256*) vinstall "$f" 644 usr/share/icons/hicolor/256x256/apps peazip.png ;;
			esac
		done
	fi
}

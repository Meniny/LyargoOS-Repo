# Template file for 'lyargoos-calamares-config'
pkgname=lyargoos-calamares-config
version=1.0
revision=2
short_desc="LyargoOS Calamares installer configuration"
maintainer="Meniny <meniny@qq.com>"
license="MIT"
homepage="https://github.com/Meniny/LyargoOS-Repo"
depends="calamares"

do_install() {
	# Main settings
	vmkdir etc/calamares
	vinstall ${FILESDIR}/settings.conf 644 etc/calamares

	# Branding
	vmkdir etc/calamares/branding/lyargoos
	vinstall ${FILESDIR}/branding.desc 644 etc/calamares/branding/lyargoos

	# Slideshow
	vmkdir etc/calamares/branding/lyargoos/slideshow
	vinstall ${FILESDIR}/slideshow/show.qml 644 etc/calamares/branding/lyargoos/slideshow

	# Module configs
	vinstall ${FILESDIR}/services-runit.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/partition.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/users.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/welcome.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/packages.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/removeuser.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/finished.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/shellprocess-setshell.conf 644 etc/calamares/modules
	vinstall ${FILESDIR}/unpackfs.conf 644 etc/calamares/modules
}
